---
import { getCollection } from 'astro:content';
import { newestFirst } from '../utils/contentOrder';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPreview from '../components/BlogPreview.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	newestFirst,
);

// Place the internship reflection immediately after Research Updates.
const reflectionIndex = posts.findIndex((post) => post.id === 'iorganbio-reflection');
if (reflectionIndex >= 0 && posts.some((post) => post.id === 'research-updates')) {
	const [reflection] = posts.splice(reflectionIndex, 1);
	const researchIndex = posts.findIndex((post) => post.id === 'research-updates');
	posts.splice(researchIndex + 1, 0, reflection);
}
---

<BaseLayout
	title="Sid Gupta | Blog"
	description="blogs"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="My Blog"
				align="start"
			/>
			<Grid variant="offset">
				{
					posts.map((project) => (
						<li>
							<BlogPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
